<?xml version="1.0" encoding="utf-8"?>
<!--
  Stale or no reading: the same blue tile with no halo, so an old value never looks coloured.
  Also the initial background before the first refresh.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF22406A" android:endColor="#FF111F35" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
