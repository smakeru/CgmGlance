<?xml version="1.0" encoding="utf-8"?>
<!-- See widget_bg_urgent.xml. Halo colour = GlucoseRangePalette.LOW. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF22406A" android:endColor="#FF111F35" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="0.0"
                android:gradientRadius="140%p"
                android:startColor="#6BFFB74D"
                android:endColor="#00FFB74D" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
