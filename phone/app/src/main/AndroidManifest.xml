<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      This APK deliberately does not declare `android.hardware.type.watch`. Declaring it with
      required="false" is rejected by lint: a single APK cannot serve both watches and phones.
      Watches are served by the separate wear module, which declares the feature as required.
    -->

    <!--
      Only for telling the user this app has stopped working. Never for glucose: no alarm for a
      low, no vibration for a high. That boundary is what keeps this a display mirror.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Restore widget age timers and expiry scheduling after the elapsed-realtime clock resets. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Write only. This app never reads anything back out of Health Connect: the glucose it holds
      came from the CGM app, and reading it back would only create a second, lagging copy of a
      number it already has.
    -->
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" />

    <!--
      Up to Android 13 Health Connect is a separate APK, and package visibility rules hide it
      unless it is named here. Without this the availability check reports "not installed" on a
      phone where it is installed and working.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Official CGM launch targets for the phone home-screen widgets. -->
        <package android:name="com.microtech.aidexx.mgdl" />
        <package android:name="com.microtech.aidexx" />
        <package android:name="com.dexcom.d1plus" />
    </queries>

    <application
        android:name=".CgmGlanceApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CgmGlance">

        <!--
          The launcher entry. Without it the app cannot be opened, a revoked permission cannot
          be restored from inside it, and a force-stopped app can never be revived — Android
          will not start a stopped app from a background trigger.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Health Connect requires somewhere to send the user when they ask why this app
              wants their glucose. Up to Android 13 it looks for this action; the status screen
              is the honest answer, since it states what is written and how often.
            -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
          The same destination, under the name Android 14 and later looks for. A separate alias
          rather than another filter on the activity: the platform matches on the alias, and
          adding the category to the launcher activity itself would change how it is launched.
        -->
        <activity-alias
            android:name=".HealthPermissionsRationaleAlias"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".GlucoseWidgetConfigureActivity"
            android:exported="true"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".GlucoseWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glucose_widget_info" />
        </receiver>

        <!-- Fires when readings have been silent for longer than a working system ever is. -->
        <receiver
            android:name=".SilenceWatchdogReceiver"
            android:exported="false" />

    </application>

</manifest>
